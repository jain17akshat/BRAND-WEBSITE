# ─── Server ────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ─── Razorpay ──────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Leave BLANK to run in mock mode (no real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket ────────────────────────────────────────────
# Get from: https://app.shiprocket.in/api-user
# Leave BLANK to run in mock mode (no real shipping)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
