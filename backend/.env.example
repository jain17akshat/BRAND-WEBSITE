# ─── Server ────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ─── Razorpay ──────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Leave BLANK to run in mock mode (no real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket ────────────────────────────────────────────
# Get from: https://app.shiprocket.in/api-user
# Leave BLANK to run in mock mode (no real shipping)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=

# ─── Email (Gmail SMTP / Nodemailer) ───────────────────────
# Destination email for alerts:
ADMIN_EMAIL=info@shraviko.com
# Your sender email (e.g. your Gmail):
EMAIL_USER=
# App Password generated from Google Account (Security -> App Passwords):
EMAIL_PASS=

# ─── Hostinger MySQL Database ──────────────────────────────
DB_HOST=localhost
DB_NAME=u220633661_shraviko_db
DB_USER=u220633661_shraviko_user
DB_PASS=Shraviko@2026Db

