# ─── Server ────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_EXTRA_ORIGINS=https://admin.shraviko.com,https://staging.shraviko.com
NODE_ENV=development

# ─── Admin Security ────────────────────────────────────────
# Secret key for administrative API authentication (Header: Authorization: Bearer <token> or X-Admin-Token)
ADMIN_API_KEY=

# ─── Razorpay ──────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Leave BLANK to run in mock mode (no real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket ────────────────────────────────────────────
# Get from: https://app.shiprocket.in/api-user
# Leave BLANK to run in mock mode (no real shipping)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_WEBHOOK_TOKEN=

# ─── Email (Gmail SMTP / Nodemailer) ───────────────────────
# Destination email for alerts:
ADMIN_EMAIL=info@shraviko.com
# Your sender email (e.g. your Gmail):
EMAIL_USER=
# App Password generated from Google Account (Security -> App Passwords):
EMAIL_PASS=

# ─── Hostinger MySQL Database ──────────────────────────────
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# ─── Hostinger Persistent Storage ──────────────────────────
# Set to persistent filesystem paths outside application deployment directory:
INVOICE_STORAGE_DIR=/home/u220633661/storage/invoices
CREDIT_NOTE_STORAGE_DIR=/home/u220633661/storage/credit-notes
